{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-extension",
      "type": "shell",
      "command": "node node_modules/typescript/bin/tsc && node node_modules/copyfiles/copyfiles.js '*.svg' dist/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/packages/vscode-extension"
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}
