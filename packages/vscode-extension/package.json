{
  "name": "driftguard",
  "displayName": "DriftGuard",
  "publisher": "CodeMedic",
  "version": "0.1.0",
  "description": "Detect architectural drift in your TypeScript codebase — catch layer violations and circular dependencies before they compound.",
  "categories": ["Linters", "Other"],
  "keywords": ["architecture", "drift", "typescript", "dependency", "circular", "layers", "analysis"],
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianmikula/DriftGuard.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "driftguard.scanWorkspace",
        "title": "DriftGuard: Scan Workspace"
      },
      {
        "command": "driftguard.scanFile",
        "title": "DriftGuard: Scan Current File"
      },
      {
        "command": "driftguard.checkStatus",
        "title": "DriftGuard: Check Engine Status"
      },
      {
        "command": "driftguard.openConfig",
        "title": "DriftGuard: Open Configuration"
      }
    ],
    "configuration": {
      "title": "DriftGuard",
      "properties": {
        "driftguard.engineUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL of the DriftGuard engine server (HTTP API). The extension communicates with the engine via this endpoint."
        },
        "driftguard.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for engine API requests."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "driftguard",
          "title": "DriftGuard",
          "icon": "activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "driftguard": [
        {
          "id": "driftguardArchitectureView",
          "name": "Architecture",
          "icon": "view-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc && copyfiles *.svg dist/",
    "watch": "tsc --watch",
    "test": "vitest",
    "lint": "echo \"Lint not implemented yet\""
  },
  "dependencies": {
    "@driftguard/core-engine": "file:../core-engine/driftguard-core-engine-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.118.0",
    "copyfiles": "^2.4.1",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
